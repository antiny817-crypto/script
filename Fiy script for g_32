    if root then
        root.CFrame=savedSpawn+Vector3.new(0,3,0)
        root.AssemblyLinearVelocity=Vector3.zero
        status.Text="TELEPORTED"
    end
end)

local function updateKey(input,value)
    local map={
        [Enum.KeyCode.W]="W",
        [Enum.KeyCode.A]="A",
        [Enum.KeyCode.S]="S",
        [Enum.KeyCode.D]="D",
        [Enum.KeyCode.Space]="Up",
        [Enum.KeyCode.LeftControl]="Down",
        [Enum.KeyCode.RightControl]="Down"
    }

    local key=map[input.KeyCode]
    if key then keys[key]=value end
end

UIS.InputBegan:Connect(function(input,processed)
    if not processed then updateKey(input,true) end
end)

UIS.InputEnded:Connect(function(input)
    updateKey(input,false)
end)

