local function make(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    make("UICorner", {CornerRadius=UDim.new(0,radius)}, obj)
end

local function outline(obj, color)
    make("UIStroke", {
        Color=color or Color3.fromRGB(65,145,235),
        Thickness=1,
        Transparency=0.15
    }, obj)
end

local function button(parent, text, size, pos, color, textSize)
    local b = make("TextButton", {
        Size=size,
        Position=pos,
        BackgroundColor3=color,
        BorderSizePixel=0,
        Text=text,
        TextColor3=Color3.fromRGB(240,245,255),
        TextSize=textSize or 12,
        Font=Enum.Font.GothamBold,
        AutoButtonColor=true
    },parent)
    round(b,7)
    return b
end

local function label(parent, text, size, pos, textSize)
    return make("TextLabel", {
        Size=size,
        Position=pos,
        BackgroundTransparency=1,
        Text=text,
        TextColor3=Color3.fromRGB(220,232,250),
        TextSize=textSize or 11,
        Font=Enum.Font.GothamBold
    },parent)
end

